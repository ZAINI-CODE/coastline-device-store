PUBLIC_SUPABASE_URL=SUPABASE_URL_PLACEHOLDER
PUBLIC_SUPABASE_ANON_KEY=SUPABASE_ANON_KEY_PLACEHOLDER
PUBLIC_PAYPAL_CLIENT_ID=PAYPAL_CLIENT_ID_PLACEHOLDER
# Keep true while the owner reviews the frontend. Disable only after backend approval.
PUBLIC_FRONTEND_REVIEW=true
# Build-time SEO settings: use the actual approved temporary hosting URL.
PUBLIC_SITE_URL=
# Set true for the approved public production build; false for private previews.
PUBLIC_INDEXING_ENABLED=false
# Set the following only as Supabase Edge Function secrets, never frontend variables:
PAYPAL_CLIENT_SECRET=PAYPAL_CLIENT_SECRET_PLACEHOLDER
PAYPAL_WEBHOOK_ID=PAYPAL_WEBHOOK_ID_PLACEHOLDER
PAYPAL_MERCHANT_ID=PAYPAL_MERCHANT_ID_PLACEHOLDER
PAYPAL_ENV=sandbox
SITE_ORIGIN=http://localhost:4173
ZELLE_RECIPIENT_EMAIL=ZELLE_RECIPIENT_EMAIL_PLACEHOLDER
ZELLE_RECIPIENT_NAME=
RESEND_API_KEY=
EMAIL_WORKER_SECRET=
# Legacy ORDER_EMAIL_WORKER_SECRET remains supported; use EMAIL_WORKER_SECRET for new setups.
# Server-side only: default test mode never drains customer/admin queues.
EMAIL_MODE=test
# Owner-controlled inbox registered with Resend (test sender restriction).
EMAIL_TEST_RECIPIENT=
# Enable ONLY in a separate Supabase test project, never the live store project.
PAYPAL_SANDBOX_ENABLED=false
PAYPAL_SANDBOX_PROJECT_REF=
